{
  "name": "tiny-desktop-mvp",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "tiny": "cli/tiny.mjs"
  },
  "files": [
    "cli",
    "runtime",
    "types",
    "native/CMakeLists.txt",
    "native/main.cpp",
    "native/resource.h",
    "native/tiny.ico",
    "native/tiny.rc"
  ],
  "scripts": {
    "check": "node cli/tiny.mjs check",
    "test": "node tests/e2e.mjs",
    "stage-runtime": "node cli/tiny.mjs stage-runtime",
    "pack:local": "node cli/tiny.mjs stage-runtime && npm pack --pack-destination .local-packages",
    "pack:create-local": "npm pack ./create-tiny-app --pack-destination .local-packages"
  },
  "engines": {
    "node": ">=20"
  }
}
