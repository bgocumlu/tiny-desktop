{
  "name": "tiny-desktop",
  "version": "0.1.3",
  "description": "Build lightweight cross-platform desktop apps with HTML, CSS, and JavaScript.",
  "type": "module",
  "keywords": [
    "desktop app",
    "cross-platform",
    "windows",
    "linux",
    "macos",
    "webview",
    "vite",
    "standalone",
    "installer"
  ],
  "license": "MIT",
  "repository": "github:bgocumlu/tiny-desktop",
  "bugs": "https://github.com/bgocumlu/tiny-desktop/issues",
  "homepage": "https://github.com/bgocumlu/tiny-desktop#readme",
  "bin": {
    "tiny": "cli/tiny.mjs"
  },
  "types": "types/index.d.ts",
  "files": [
    "cli",
    "runtime",
    "types"
  ],
  "dependencies": {
    "resedit": "^3.0.2"
  },
  "scripts": {
    "check": "node cli/tiny.mjs check",
    "test": "node tests/e2e.mjs",
    "stage-runtime": "node cli/tiny.mjs stage-runtime",
    "pack:local": "node cli/tiny.mjs stage-runtime && npm pack --pack-destination .local-packages",
    "pack:create-local": "npm pack ./create-tiny-desktop --pack-destination .local-packages"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
